#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// neon-green — palette
//   #00ff41  neon      primary accent: focus, current item, progress
//   #39ff14  bright    highlights, search matches, insert mode
//   #7cffa0  mint      secondary text, filenames, song icons
//   #1f8f43  dim       unfocused borders (lets the focused pane stand out)
//   #0e5c2a  deep      scrollbar track, inactive chrome
//   #6f8f79  muted     missing metadata, labels
//   #e9ffef  ice       titles, primary emphasis
//   #ff2b2b  red       errors, oneshot modes
(
    default_album_art_path: "/home/r3dg0d/.config/rmpc/assets/default-art.jpg",
    format_tag_separator: " · ",
    browser_column_widths: [20, 38, 42],
    background_color: None,
    text_color: None,
    header_background_color: None,
    modal_background_color: None,
    // Dim the UI behind modals so dialogs read as floating, not pasted on.
    modal_backdrop: true,
    preview_label_style: (fg: "#6f8f79"),
    preview_metadata_group_style: (fg: "#00ff41", modifiers: "Bold"),
    highlighted_item_style: (fg: "#39ff14", modifiers: "Bold"),
    current_item_style: (fg: "#001a08", bg: "#00ff41", modifiers: "Bold"),
    // Unfocused borders recede, focused border glows — this is what gives the
    // layout depth. Previously both were the same neon and everything shouted.
    borders_style: (fg: "#1f8f43"),
    highlight_border_style: (fg: "#00ff41"),
    symbols: (
        song: "",
        dir: "",
        playlist: "",
        marker: "",
        ellipsis: "…",
        song_style: (fg: "#7cffa0"),
        dir_style: (fg: "#00ff41", modifiers: "Bold"),
        playlist_style: (fg: "#39ff14"),
    ),
    level_styles: (
        info: (fg: "#00ff41", bg: "#001a08"),
        warn: (fg: "#ffd166", bg: "#001a08"),
        error: (fg: "#ff2b2b", bg: "#001a08"),
        debug: (fg: "#39ff14", bg: "#001a08"),
        trace: (fg: "#7cffa0", bg: "#001a08"),
    ),
    progress_bar: (
        symbols: ["━", "━", "╸", "─", "─"],
        track_style: (fg: "#0e5c2a"),
        elapsed_style: (fg: "#00ff41"),
        thumb_style: (fg: "#39ff14", modifiers: "Bold"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#0e5c2a"),
        ends_style: (fg: "#1f8f43"),
        thumb_style: (fg: "#00ff41"),
    ),
    tab_bar: (
        active_style: (fg: "#001a08", bg: "#00ff41", modifiers: "Bold"),
        inactive_style: (fg: "#6f8f79"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    // Title falls back to the filename rather than "Unknown". The library is
    // untagged, so this is the difference between a readable queue and 300
    // identical rows.
    song_table_format: [
        (
            prop: (kind: Property(Title), style: (fg: "#e9ffef"),
                default: (kind: Property(Filename), style: (fg: "#7cffa0"))
            ),
            label_prop: (kind: Text("Title")),
            width: "46%",
        ),
        (
            prop: (kind: Property(Artist), style: (fg: "#00ff41"),
                default: (kind: Text("—"), style: (fg: "#6f8f79"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#7cffa0"),
                default: (kind: Text("—"), style: (fg: "#6f8f79"))
            ),
            label_prop: (kind: Text("Album")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#6f8f79"),
                default: (kind: Text("-"), style: (fg: "#6f8f79"))
            ),
            label_prop: (kind: Text("Duration")),
            width: "14%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "RIGHT | LEFT | BOTTOM",
                border_symbols: Rounded,
                size: "2",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "12",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_right: "┬", bottom_right: "┴"),
                            pane: Component("input_mode")
                        ),
                        (
                            size: "100%",
                            borders: "TOP | BOTTOM | RIGHT",
                            border_symbols: Rounded,
                            border_title: [
                                (kind: Text(" ")),
                                (kind: Text(""), style: (fg: "#00ff41")),
                                (kind: Text(" ")),
                                (kind: Property(Status(QueueLength())), style: (fg: "#e9ffef", modifiers: "Bold")),
                                (kind: Text(" songs "), style: (fg: "#6f8f79")),
                                (kind: Text("· "), style: (fg: "#1f8f43")),
                                (kind: Property(Status(QueueTimeTotal())), style: (fg: "#7cffa0")),
                                (kind: Text(" "), style: (fg: "#6f8f79")),
                            ],
                            border_title_alignment: Right,
                            pane: Component("progress_bar"),
                        ),
                    ]
                ),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text(" "), style: (fg: "#00ff41", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#e9ffef", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#e9ffef", modifiers: "Bold"),
                    default: (kind: Property(Song(Filename)), style: (fg: "#7cffa0", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "2", pane: Pane(Property(content: [(kind: Text(" "), style: (fg: "#00ff41"))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "━", thumb: "●", track: "─"))))),
                (size: "4", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#e9ffef", modifiers: "Bold"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#6f8f79"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#00ff41", modifiers: "Bold")),
                (kind: Text(" / "), style: (fg: "#1f8f43")),
                (kind: Property(Status(Duration)), style: (fg: "#7cffa0")),
                (kind: Group([
                    (kind: Text("  "), style: (fg: "#6f8f79")),
                    (kind: Property(Status(Bitrate)), style: (fg: "#6f8f79")),
                    (kind: Text(" kbps"), style: (fg: "#6f8f79")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#00ff41", modifiers: "Bold"),
                    default: (kind: Text("Unknown Artist"), style: (fg: "#6f8f79"))),
                (kind: Text("  ·  "), style: (fg: "#1f8f43")),
                (kind: Property(Song(Album)), style: (fg: "#7cffa0"),
                    default: (kind: Text("Unknown Album"), style: (fg: "#6f8f79"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#39ff14"), align: Left)]))
                ),
                (
                    size: "10",
                    pane: Pane(Property(content: [
                        (kind: Property(Status(RepeatV2(
                            on_label: " ",
                            off_label: " ",
                            on_style: (fg: "#00ff41", modifiers: "Bold"),
                            off_style: (fg: "#0e5c2a"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: " ",
                            off_label: " ",
                            on_style: (fg: "#00ff41", modifiers: "Bold"),
                            off_style: (fg: "#0e5c2a"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: " ",
                            off_label: " ",
                            oneshot_label: " ",
                            on_style: (fg: "#00ff41", modifiers: "Bold"),
                            off_style: (fg: "#0e5c2a"),
                            oneshot_style: (fg: "#ff2b2b", modifiers: "Bold"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "",
                            off_label: "",
                            oneshot_label: "",
                            on_style: (fg: "#00ff41", modifiers: "Bold"),
                            off_style: (fg: "#0e5c2a"),
                            oneshot_style: (fg: "#ff2b2b", modifiers: "Bold"),
                        )))),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#001a08", bg: "#00ff41", modifiers: "Bold"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#001a08", bg: "#39ff14", modifiers: "Bold"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(ProgressBar)
                ),
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
            ]
        )
    },
)
