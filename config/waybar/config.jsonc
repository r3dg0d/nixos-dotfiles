{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 6,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["group/music", "clock"],
  "modules-right": ["tray", "custom/weather", "temperature", "pulseaudio", "network", "cpu", "memory", "battery", "custom/nixupdate", "custom/mirror", "custom/power"],

  // NOTE: nerd-font icons are written as \uXXXX escapes on purpose — keep
  // them that way so they survive editors/tools that mangle PUA glyphs.
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "urgent": ""
    },
    "on-click": "activate"
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },

  // ── music player ────────────────────────────────────────────────────────
  // Backed by MPD on localhost:6600 — the same daemon rmpc drives, so the bar
  // and the TUI always agree. Helper: config/scripts/music/mpd-widget.py
  "group/music": {
    "orientation": "horizontal",
    "modules": [
      "image#albumart",
      "custom/music",
      "cava",
      "custom/music-prev",
      "custom/music-play",
      "custom/music-next",
      "custom/music-loop"
    ]
  },

  "image#albumart": {
    "exec": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py art",
    "size": 22,
    "interval": 3,
    "tooltip": false
  },

  // Long-running: blocks on MPD `idle` and reprints instantly on any change,
  // so there is no polling lag on the track name.
  "custom/music": {
    "exec": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py watch",
    "return-type": "json",
    "max-length": 38,
    "escape": true,
    "on-click": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py toggle",
    "on-scroll-up": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py next",
    "on-scroll-down": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py prev"
  },

  "cava": {
    "framerate": 60,
    "autosens": 1,
    "bars": 12,
    "method": "pipewire",
    "source": "auto",
    "stereo": false,
    "bar_delimiter": 0,
    "hide_on_silence": false,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },

  "custom/music-play": {
    "exec": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py playicon",
    "return-type": "json",
    "interval": 2,
    "signal": 10,
    "on-click": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py toggle"
  },

  "custom/music-prev": {
    "format": "\uf048",
    "tooltip": true,
    "tooltip-format": "Previous track",
    "on-click": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py prev"
  },

  "custom/music-next": {
    "format": "\uf051",
    "tooltip": true,
    "tooltip-format": "Next track",
    "on-click": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py next"
  },

  "custom/music-loop": {
    "exec": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py loopicon",
    "return-type": "json",
    "interval": 2,
    "signal": 11,
    "on-click": "python3 $HOME/nixos-dotfiles/config/scripts/music/mpd-widget.py loop"
  },

  "clock": {
    "format": " {:%I:%M %p}",
    "format-alt": " {:%a %d %b %Y}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 2
  },

  "memory": {
    "format": "󰍛 {percentage}%",
    "interval": 5
  },

  "temperature": {
    "thermal-zone": 0,
    "interval": 2,
    "critical-threshold": 90,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", "", "", ""]
  },

  "custom/weather": {
    "exec": "curl -s --max-time 5 'https://wttr.in/?format=%c%t' | tr -d ' '",
    "interval": 900,
    "format": "{}",
    "tooltip": false,
    "on-click": "xdg-open https://wttr.in"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "network": {
    "format-wifi": " {ipaddr}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": " offline",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) — {ipaddr}",
    "on-click": "qs ipc call wifi toggle"
  },

  // Scrolling the icon goes through `fnkey`, exactly like Fn+F11/F12, so the
  // wheel raises the quickshell OSD as well as the volume. Defining
  // on-scroll-* replaces waybar's own internal volume handling rather than
  // stacking on top of it, so one notch stays one 5% step; the module text
  // still follows pipewire either way.
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "default": ["", "", ""] },
    "on-click": "ghostty --title='Audio Switcher' -e node $HOME/nixos-dotfiles/config/scripts/audio-switcher/cli.js",
    "on-click-right": "pavucontrol",
    "on-click-middle": "fnkey mute",
    "on-scroll-up": "fnkey volume-up",
    "on-scroll-down": "fnkey volume-down",
    "smooth-scrolling-threshold": 1
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  // ── system updates ──────────────────────────────────────────────────────
  // Reads the cache `nixos-update-check` writes, so the poll below is a file
  // read and nothing else. The real check runs on its own systemd user timer
  // (my.updater.interval) and raises RTMIN+13 when it has a new answer, which
  // is what makes the count update the moment an update finishes rather than
  // up to five minutes later. Signal number is my.updater.waybarSignal.
  "custom/nixupdate": {
    "exec": "nixos-update-waybar",
    "return-type": "json",
    "interval": 300,
    "signal": 13,
    "tooltip": true,
    "on-click": "qs ipc call updater toggle",
    "on-click-right": "ghostty --title='NixOS Update Check' -e sh -c 'nixos-update-check; printf \"\\n[enter to close] \"; read _'",
    "on-click-middle": "nixos-update-check --quiet"
  },

  "custom/mirror": {
    "exec": "$HOME/nixos-dotfiles/config/quickshell/Mirror/scripts/mirror-status",
    "return-type": "json",
    "interval": 2,
    "signal": 12,
    "on-click": "$HOME/nixos-dotfiles/config/quickshell/Mirror/scripts/mirror-toggle",
    "tooltip": true
  },

  "custom/power": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "Power menu",
    "on-click": "qs ipc call power toggle"
  }
}
