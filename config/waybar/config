{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 10,
    "margin-left": 160,
    "margin-right": 160,
    "spacing": 0,
    "exclusive-zone": 50,

    "modules-left":   ["niri/workspaces", "custom/ws-info"],
    "modules-center": ["clock"],
    "modules-right":  ["custom/weather", "temperature", "cpu", "memory",
                       "wireplumber", "network", "tray", "custom/sysinfo"],

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active":  "●",
            "default": "○",
            "urgent":  "⬤"
        }
    },

    "custom/ws-info": {
        "exec":        "/home/r3dg0d/.local/bin/waybar-ws-info",
        "return-type": "json",
        "interval":    2,
        "on-click":    "bash -c 'S=$(cat /tmp/qs-ws-show 2>/dev/null||echo 0); [ \"$S\"=1 ] && echo 0>/tmp/qs-ws-show || echo 1>/tmp/qs-ws-show'"
    },

    "clock": {
        "format":         " {:%I:%M %p}",
        "format-alt":     "󰃶 {:%A, %B %-d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "custom/weather": {
        "exec":        "/home/r3dg0d/.local/bin/waybar-weather",
        "return-type": "json",
        "interval":    900,
        "on-click":    "xdg-open 'https://wttr.in' 2>/dev/null || true"
    },

    "temperature": {
        "critical-threshold": 85,
        "interval":           5,
        "format":             "{icon} {temperatureC}°C",
        "format-icons":       ["󱃃", "󰔏", "󰸁"],
        "tooltip":            false
    },

    "cpu": {
        "interval": 3,
        "format":   " {usage}%",
        "tooltip":  false
    },

    "memory": {
        "interval":       5,
        "format":         " {percentage}%",
        "tooltip-format": "{used:0.1f} G / {total:0.1f} G"
    },

    "wireplumber": {
        "format":         "{icon} {volume}%",
        "format-muted":   "󰖁 muted",
        "on-click":       "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "ghostty --title='Audio Manager' -e /home/r3dg0d/.local/bin/audio-manager",
        "format-icons":   ["󰕿", "󰖀", "󰕾"]
    },

    "network": {
        "format-wifi":       "󰤨 {essid}",
        "format-ethernet":   "󰈀 {ipaddr}",
        "format-disconnected":"󰤭 off",
        "tooltip-format":    "{ifname}: {ipaddr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}",
        "on-click":          "ghostty --title='Network Manager' -e nmtui"
    },

    "tray": {
        "icon-size": 16,
        "spacing":   8
    },

    "custom/sysinfo": {
        "exec":        "/home/r3dg0d/.local/bin/waybar-sysinfo-brief",
        "return-type": "json",
        "interval":    3,
        "on-click":    "bash -c 'S=$(cat /tmp/qs-sysinfo-show 2>/dev/null||echo 0); [ \"$S\"=1 ] && echo 0>/tmp/qs-sysinfo-show || echo 1>/tmp/qs-sysinfo-show'"
    }
}
