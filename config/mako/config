# mako — OLED black / white text / neon-green border
font=JetBrainsMono Nerd Font 11
background-color=#000000
text-color=#ffffff
border-color=#00ff41
progress-color=over #00ff41
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=5000
max-visible=5
anchor=top-right
icons=1
