{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": { "1": "green" }
  },
  "display": {
    "color": { "keys": "green", "title": "white" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    {
      "type": "command",
      "key": "OS Age",
      "text": "b=$(stat -c %W /); [ \"$b\" -le 0 ] && b=$(stat -c %W /nix/var/nix/db); echo \"$(( ( $(date +%s) - b ) / 86400 )) days\""
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    { "type": "weather", "key": "Weather", "timeout": 3000 },
    {
      "type": "command",
      "key": "Lat / Long",
      "text": "curl -s --max-time 3 ipinfo.io/loc || echo offline"
    },
    {
      "type": "command",
      "key": "Map",
      "text": "loc=$(curl -s --max-time 3 ipinfo.io/loc); [ -n \"$loc\" ] && echo \"https://www.google.com/maps?q=$loc\" || echo offline"
    },
    "break",
    "colors"
  ]
}
