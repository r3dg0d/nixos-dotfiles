{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": { "1": "green" }
  },
  "display": {
    "color": { "keys": "green", "title": "white" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    {
      "type": "command",
      "key": "OS Age",
      "text": "b=$(stat -c %W /); [ \"$b\" -le 0 ] && b=$(stat -c %W /nix/var/nix/db); echo \"$(( ( $(date +%s) - b ) / 86400 )) days\""
    },
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    { "type": "weather", "key": "Weather", "timeout": 3000 },
    "break",
    "colors"
  ]
}
