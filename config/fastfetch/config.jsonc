{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    {
      "type": "command",
      "key": "OS Age",
      "text": "sh -c 'install=$(stat -c %W /); now=$(date +%s); diff=$((now-install)); printf \"%dd %dh\" $((diff/86400)) $(((diff%86400)/3600))'"
    },
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    {
      "type": "command",
      "key": "RAM",
      "text": "awk '/MemTotal:/{gb=$2/1024/1000; printf \"%.0f GB\", gb}' /proc/meminfo"
    },
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    {
      "type": "weather",
      "key": "Weather"
    },
    "break",
    "colors"
  ]
}
