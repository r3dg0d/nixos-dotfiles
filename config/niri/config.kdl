// niri — OLED black / white borders / neon-green glowing accents

input {
    keyboard {
        xkb {
            // layout "us"
        }
        repeat-delay 200
        repeat-rate 35
    }
    touchpad {
        tap
        natural-scroll
        accel-speed 0.2
    }
    focus-follows-mouse
}

// Monitors: Alienware AW3425DWM on the LEFT, ASUS VG34VQ3B on the RIGHT.
// NOTE: @180 only engages if the link advertises it. Over the current
// connection both cap at 3440x1440@60 (see HDMI/DP note); niri keeps the
// native resolution and falls back to 60Hz until a DP1.4 link is present.
output "Dell Inc. AW3425DWM 4G2YF94" {
    mode "3440x1440@180.000"
    position x=0 y=0
}
output "ASUSTek COMPUTER INC VG34VQ3B T8LMTR044980" {
    mode "3440x1440@180.000"
    position x=3440 y=0
}

layout {
    gaps 10

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    // The frame is a white → neon-green sweep rather than a flat ring, and
    // `relative-to="workspace-view"` is the point of it: the gradient is
    // mapped across the whole visible workspace, not re-run per window. Every
    // focused window therefore shows the *slice* of the sweep it happens to
    // sit under — white over on the left of the view, full green by the right
    // — so a row of windows reads as one continuous run of light instead of
    // several identical outlines. Moving a column re-cuts its colour.
    focus-ring {
        width 2
        active-gradient from="#ffffff" to="#00ff41" angle=135 relative-to="workspace-view"
        inactive-color "#141414"
    }
    border {
        off
    }

    // Depth instead of bloom. The old shadow was a green glow doing the same
    // job as the ring, which on OLED black smeared the edge it was supposed to
    // define; this leaves the gradient as the only light on the desktop.
    //
    // Note what a near-black shadow can and cannot do here: over the OLED
    // background it is invisible by construction, which is the point — no
    // grey wash on true black. It earns its keep on the layers that *do* have
    // something behind them: floating windows over other windows, and the
    // lighter regions of a future wallpaper.
    shadow {
        on
        softness 24
        spread 0
        offset x=0 y=8
        color "#000000cc"
    }

    // Where a dragged window would land, in the same green.
    insert-hint {
        gradient from="#00ff4166" to="#00b32d66" angle=135 relative-to="workspace-view"
    }
}

// Rounded corners, clipped to the rounding
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

// The screensaver terminals (pkgs/nixos-screensaver). The app-id is the
// contract: the control script matches on it too, so this rule and that
// script have to agree. Fullscreen and square — no rounding, no focus ring,
// no shadow, because none of that belongs on a black screen showing a logo.
window-rule {
    match app-id="^nixos-screensaver$"

    open-fullscreen true
    open-focused true
    geometry-corner-radius 0
    clip-to-geometry false
    focus-ring { off; }
    shadow { off; }
}

window-rule {
    match title="^Mirror$"

    open-floating true
    open-focused false
    default-floating-position x=32 y=32 relative-to="top-right"
}

// Spawn on startup
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
spawn-at-startup "qs"
// Wallpaper. Home Manager materialises this file from the repo
// (assets/wallpapers/wallpaper.jpg); $HOME is expanded by the shell rather
// than hardcoded so the same config works for any user.
spawn-at-startup "sh" "-c" "exec swaybg -m fill -i \"$HOME/Pictures/Wallpaper/wallpaper.jpg\""

// The SIVA stack (F7 voicefetch, F8 assistant, F9 dictation) is NOT spawned
// here any more: siva.service, siva-wake.service, siva-voicefetch.service,
// siva-type.service and siva-llama-server.service are systemd user units
// declared by modules/nixos/siva, so they start under COSMIC too, restart on
// failure, and log to journalctl --user. See the README.

prefer-no-csd

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
    slowdown 1.0
}

binds {
    // Compositor controls (niri hot-reloads this file on save)
    Mod+Shift+E { quit; }

    // Applications
    Mod+Return       { spawn "ghostty"; }
    Mod+Shift+Return { spawn "alacritty"; }
    Mod+Space        { spawn "rofi" "-show" "drun"; }
    Mod+D            { spawn "rofi" "-show" "drun"; }
    Mod+Shift+D      { spawn "rofi" "-show" "run"; }
    Mod+E            { spawn "sh" "-c" "exec \"$HOME/nixos-dotfiles/config/scripts/emojipick-rofi.sh\""; }
    Mod+N            { spawn "nautilus"; }

    // Window management
    Mod+Q { close-window; }
    Mod+Shift+Q { close-window; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Shift+C { center-column; }

    // Quickshell clipboard manager (center-column moved to Mod+Shift+C)
    Mod+C { spawn "qs" "ipc" "call" "clipboard" "toggle"; }

    // SIVA voice assistant stack. These are the toggle *clients* — they send
    // one JSON message to the daemon's socket (and start the daemon themselves
    // if the systemd unit is stopped), so they are safe to press at any time.
    // Resolved from $PATH: the packages are in systemPackages.
    F7 repeat=false hotkey-overlay-title="SIVA Voicefetch: voice models (toggle)" {
        spawn "siva-voicefetch";
    }
    F8 repeat=false hotkey-overlay-title="SIVA: voice assistant (push-to-talk toggle)" {
        spawn "siva";
    }
    F9 repeat=false hotkey-overlay-title="SIVA-Type: AI dictation (toggle)" {
        spawn "siva-type";
    }

    // Focus movement
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Window movement
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }

    // Column sizing
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+R { switch-preset-column-width; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }
    Mod+Tab         { focus-workspace-down; }
    Mod+Shift+Tab   { focus-workspace-up; }

    // Screenshots — feathershot replaces niri's built-in screenshot tool
    Print { spawn "feathershot"; }
    Ctrl+Print { spawn "feathershot" "-f"; }

    // ── Fn + F1…F12 ──────────────────────────────────────────────────────
    // The keyboard's Fn layer emits the standard XF86 media/system keysyms,
    // not F1…F12, which is why these do not collide with the bare F7/F8/F9
    // SIVA binds above.
    //
    // Every one of them goes through `fnkey` (pkgs/fnkeys): it performs the
    // action and then hands the resulting state to the quickshell OSD
    // (config/quickshell/Osd.qml), so the visual can never disagree with what
    // actually happened. Run `fnkey` with no argument for the action list.
    //
    // If a key does nothing, find out what it really emits with `wev` and
    // rename the bind — niri hot-reloads this file, so it is a one-line fix.

    // F1 / F2 — display brightness. Desktop monitors have no backlight sysfs
    // node; this drives the panels over DDC/CI (see pkgs/monitor-brightness).
    XF86MonBrightnessDown allow-when-locked=true hotkey-overlay-title="Brightness down (DDC/CI)" { spawn "fnkey" "brightness-down"; }
    XF86MonBrightnessUp   allow-when-locked=true hotkey-overlay-title="Brightness up (DDC/CI)"   { spawn "fnkey" "brightness-up"; }

    // F3 — the niri overview. Which keysym the "task view" key sends is not
    // standardised, so the three plausible ones are all bound to it.
    XF86LaunchA  hotkey-overlay-title="Overview" { spawn "fnkey" "overview"; }
    XF86LaunchB  hotkey-overlay-title="Overview" { spawn "fnkey" "overview"; }
    XF86TaskPane hotkey-overlay-title="Overview" { spawn "fnkey" "overview"; }

    // F4 — SearXNG search widget (config/quickshell/WebSearch.qml)
    XF86Search repeat=false hotkey-overlay-title="Web search (SearXNG)" { spawn "fnkey" "search"; }

    // F5 — microphone mute switch
    XF86AudioMicMute allow-when-locked=true repeat=false hotkey-overlay-title="Microphone mute" { spawn "fnkey" "mic-mute"; }

    // F6 — the webcam mirror overlay (config/quickshell/Mirror)
    XF86WebCam  repeat=false hotkey-overlay-title="Webcam mirror" { spawn "fnkey" "webcam"; }
    XF86Display repeat=false hotkey-overlay-title="Webcam mirror" { spawn "fnkey" "webcam"; }

    // F7 / F8 / F9 — transport, over MPRIS (playerctl), so it drives whatever
    // is actually playing: mpd/rmpc, mpv, the browser.
    XF86AudioPrev allow-when-locked=true repeat=false hotkey-overlay-title="Previous track"     { spawn "fnkey" "previous"; }
    XF86AudioPlay allow-when-locked=true repeat=false hotkey-overlay-title="Play / pause"       { spawn "fnkey" "play-pause"; }
    XF86AudioNext allow-when-locked=true repeat=false hotkey-overlay-title="Next track"         { spawn "fnkey" "next"; }
    XF86AudioPause allow-when-locked=true repeat=false { spawn "fnkey" "play-pause"; }

    // F10 / F11 / F12 — output volume
    XF86AudioMute        allow-when-locked=true repeat=false hotkey-overlay-title="Mute output" { spawn "fnkey" "mute"; }
    XF86AudioLowerVolume allow-when-locked=true hotkey-overlay-title="Volume down"              { spawn "fnkey" "volume-down"; }
    XF86AudioRaiseVolume allow-when-locked=true hotkey-overlay-title="Volume up"                { spawn "fnkey" "volume-up"; }

    // Keyboard-independent aliases for the two Fn keys worth having on the
    // home row as well — and the only way to reach them from a board with no
    // Fn layer at all.
    Mod+O { spawn "fnkey" "overview"; }
    Mod+S { spawn "fnkey" "search"; }
}
