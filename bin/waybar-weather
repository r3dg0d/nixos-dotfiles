#!/usr/bin/env python3
# Weather module for Waybar — uses wttr.in, safely JSON-encodes output
import json
import urllib.request

def fetch(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "curl/7.0"})
        with urllib.request.urlopen(req, timeout=5) as r:
            return r.read().decode(errors="replace").strip()
    except Exception:
        return None

text    = fetch("https://wttr.in/?format=%c+%t&m") or "? --°C"
tooltip = fetch("https://wttr.in/?format=3&m")      or "No weather data"
print(json.dumps({"text": text, "tooltip": tooltip, "class": "weather"}))
