#!/usr/bin/env bash
# Push-to-talk voice typing via whisper.cpp.
# Records from Scarlett 2i2 Mic1 directly via pw-record --target.

PIDFILE=/tmp/voice-type.pid
STATEFILE=/tmp/qs-voice-state
RECFILE=/tmp/voice-record.wav
LOGFILE=/tmp/voice-type.log
MODEL="$HOME/.local/share/voice-type/models/ggml-tiny.bin"

log() { echo "[$(date +%H:%M:%S)] $*" >> "$LOGFILE"; }

# Find the Scarlett 2i2 Mic1 hardware source node ID.
scarlett_id() {
    wpctl status 2>/dev/null | awk '
        /Focusrite/ && /Mic1__source \[Audio\/Source\]/ {
            for (i=1; i<=NF; i++) if ($i ~ /^[0-9]+\.$/) { print $i+0; exit }
        }
    '
}

if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    # ── STOP ──────────────────────────────────────────────────────────
    RECORDER_PID=$(cat "$PIDFILE")
    log "STOP: killing recorder pid=$RECORDER_PID"

    kill -INT "$RECORDER_PID" 2>/dev/null
    sleep 0.3
    kill -TERM "$RECORDER_PID" 2>/dev/null

    # pw-record was started by a different bash invocation, so 'wait' is
    # ineffective here. Poll until the process actually exits so the WAV
    # footer is fully flushed before we read it.
    for _ in $(seq 1 40); do
        kill -0 "$RECORDER_PID" 2>/dev/null || break
        sleep 0.05
    done

    rm -f "$PIDFILE"
    echo transcribing > "$STATEFILE"

    log "STOP: recfile=$(ls -lh "$RECFILE" 2>/dev/null || echo MISSING)"

    if [[ ! -f "$MODEL" ]]; then
        log "ERROR: model missing at $MODEL"
        notify-send -u critical "voice-type" "Model missing — run voice-type-setup" 2>/dev/null
        echo idle > "$STATEFILE"
        exit 1
    fi

    if [[ -f "$RECFILE" && -s "$RECFILE" ]]; then
        log "TRANSCRIBE: running whisper-cli"
        TEXT=$(whisper-cli -m "$MODEL" -f "$RECFILE" -l en -np -nt 2>>"$LOGFILE" \
               | grep -v "^\[" | grep -v "^$" \
               | sed 's/^[[:space:]]*//' | tr '\n' ' ' | xargs)
        log "TRANSCRIBE: got='$TEXT'"
        if [[ -n "$TEXT" ]]; then
            printf '%s' "$TEXT" | wtype -
            log "TYPED: '$TEXT'"
        fi
        rm -f "$RECFILE"
    else
        log "ERROR: recfile missing or empty after stop"
        notify-send "voice-type" "Recording was empty — check /tmp/voice-type.log" 2>/dev/null
    fi
    echo idle > "$STATEFILE"

else
    # ── START ─────────────────────────────────────────────────────────
    : > "$LOGFILE"
    rm -f "$PIDFILE" "$RECFILE"
    echo recording > "$STATEFILE"

    SID=$(scarlett_id)
    log "START: scarlett node=$SID (PIPEWIRE_RUNTIME_DIR=$PIPEWIRE_RUNTIME_DIR XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR)"

    if [[ -n "$SID" ]]; then
        pw-record --target "$SID" --format s16 --rate 16000 --channels 1 "$RECFILE" &
        log "START: pw-record pid=$! target=$SID"
    else
        log "START: Scarlett not found, falling back to arecord"
        arecord -f S16_LE -r 16000 -c 1 -q "$RECFILE" &
        log "START: arecord pid=$!"
    fi
    echo $! > "$PIDFILE"
fi
