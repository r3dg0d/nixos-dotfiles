#!/usr/bin/env bash
# Full system stats JSON for Quickshell SysInfoPopup

# CPU usage — two /proc/stat snapshots 200ms apart
read -r CPU_T1 CPU_I1 <<< "$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5; exit}' /proc/stat)"
sleep 0.2
read -r CPU_T2 CPU_I2 <<< "$(awk '/^cpu /{print $2+$3+$4+$5+$6+$7+$8, $5; exit}' /proc/stat)"
CPU_USAGE=$(awk "BEGIN{dt=$CPU_T2-$CPU_T1; di=$CPU_I2-$CPU_I1; printf \"%d\", dt>0?(1-di/dt)*100:0}")

# CPU temp (Intel/AMD)
CPU_TEMP=$(sensors 2>/dev/null \
    | grep -m1 -iE 'Package id 0|Tctl|CPU Temperature' \
    | grep -oP '[0-9]+\.[0-9]+' | head -1 || echo "?")

# RAM
MEM_TOTAL=$(awk '/MemTotal/{printf "%.1f", $2/1024/1024}' /proc/meminfo)
MEM_AVAIL=$(awk '/MemAvailable/{printf "%.1f", $2/1024/1024}' /proc/meminfo)
MEM_USED=$(awk "BEGIN{printf \"%.1f\", $MEM_TOTAL-$MEM_AVAIL}")
MEM_PCT=$(awk "BEGIN{printf \"%d\", ($MEM_USED/$MEM_TOTAL)*100}")

# Disk (root)
DISK_USED=$(df -BG / 2>/dev/null | awk 'NR==2{gsub(/G/,"",$3); print $3}')
DISK_TOTAL=$(df -BG / 2>/dev/null | awk 'NR==2{gsub(/G/,"",$2); print $2}')
DISK_PCT=$(df / 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5}')

# GPU — NVIDIA
GPU_TEMP="?"; GPU_UTIL="?"; GPU_MEM_USED="?"; GPU_MEM_TOTAL="?"
if command -v nvidia-smi &>/dev/null; then
    IFS=',' read -r GPU_TEMP GPU_UTIL GPU_MEM_USED GPU_MEM_TOTAL < <(
        nvidia-smi --query-gpu=temperature.gpu,utilization.gpu,memory.used,memory.total \
            --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
fi

python3 - <<EOF
import json
print(json.dumps({
    "cpu_usage":   "$CPU_USAGE",
    "cpu_temp":    "$CPU_TEMP",
    "ram_used":    "${MEM_USED}G",
    "ram_total":   "${MEM_TOTAL}G",
    "ram_pct":     "$MEM_PCT",
    "disk_used":   "${DISK_USED}G",
    "disk_total":  "${DISK_TOTAL}G",
    "disk_pct":    "$DISK_PCT",
    "gpu_util":    "$GPU_UTIL",
    "gpu_temp":    "$GPU_TEMP",
    "gpu_mem_used":   "${GPU_MEM_USED}MB",
    "gpu_mem_total":  "${GPU_MEM_TOTAL}MB"
}))
EOF
