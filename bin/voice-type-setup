#!/usr/bin/env bash
# One-time setup — creates venv, installs faster-whisper, pre-downloads the model.
set -euo pipefail

VENV="$HOME/.local/share/voice-type/venv"
mkdir -p "$(dirname "$VENV")"

echo "[1/4] Creating Python venv at $VENV …"
python3 -m venv "$VENV"

echo "[2/4] Installing faster-whisper and dependencies …"
"$VENV/bin/pip" install --upgrade pip -q
"$VENV/bin/pip" install faster-whisper numpy soundfile -q

echo "[3/4] Pre-downloading Whisper tiny model (~39 MB) …"
"$VENV/bin/python3" -c "
from faster_whisper import WhisperModel
WhisperModel('tiny', device='cpu', compute_type='int8')
print('  Model cached.')
"

echo "[4/4] Done! Press F9 to toggle recording."
