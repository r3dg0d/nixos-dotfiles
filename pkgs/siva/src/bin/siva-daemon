#!/usr/bin/env python3
"""SIVA orchestrator daemon.

Bridges the quickshell overlay (unix socket, newline-JSON), audio capture
(pw-record + whisper.cpp), the llama.cpp server (OpenAI-compatible streaming
API with tools), desktop control (niri msg / ydotool / wtype / grim), and
TTS (piper). Stdlib only.

Protocol, daemon -> UI (one JSON object per line):
  {"type":"show"} / {"type":"hide"}
  {"type":"status","value":"idle|listening|thinking|executing|speaking|error"}
  {"type":"mic","device":"..."}
  {"type":"transcript","text":"..."}      user's words after STT
  {"type":"cot","text":"..."}             chain-of-thought delta (append)
  {"type":"cot_clear"}
  {"type":"tool","text":"..."}            human-readable tool execution line
  {"type":"reply","text":"..."}           final-answer delta (append)
  {"type":"reply_clear"}
  {"type":"error","text":"..."}

UI/keybind -> daemon:
  {"type":"toggle"}        F8 semantics: open+listen / stop+process / cancel
  {"type":"user_text","text":"..."}
  {"type":"cancel"}
  {"type":"hide"}
"""

import array
import base64
