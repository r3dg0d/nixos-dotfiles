MIC_FILE = os.path.join(HOME, ".local/share/siva/mic.json")  # persisted input choice
YDOTOOL_ENV = {**os.environ, "YDOTOOL_SOCKET": os.environ.get("YDOTOOL_SOCKET", "/run/ydotoold/socket")}

