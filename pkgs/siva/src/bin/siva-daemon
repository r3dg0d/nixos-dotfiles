LOG = "/tmp/siva-daemon.log"

LLAMA_HOST = "127.0.0.1"
LLAMA_PORT = 8090
MAX_TOOL_ROUNDS = 8
# The llama server runs at a small fixed context (VRAM headroom on the 4090 —
# see siva-llm). The system prompt + tool schemas already eat ~3.3k of it, so
# the agent loop trims old conversation turns to fit and never overflows.
LLAMA_CTX = int(os.environ.get("SIVA_LLAMA_CTX", "4096"))
CTX_REPLY_RESERVE = 640   # tokens kept free for the model's reasoning + reply

# ── Durable memory (MemPalace) ────────────────────────────────────────────
# SIVA gets long-term, cross-session memory from MemPalace (https://github.com/
# MemPalace/mempalace): a local-first AI memory store. We talk to a long-lived
# `mempalace-mcp` subprocess over its MCP stdio transport — newline-delimited
# JSON-RPC, the exact framing SIVA already speaks on its own UI socket — so the
# ~300 MB embedding model loads once and stays warm. The model files "drawers"
# it can search later via the remember/recall tools, and every turn is silently
# seeded with relevant past memories (auto-recall).
#
# Entirely optional and fail-soft: if `mempalace-mcp` is not installed the
# feature disables itself and SIVA behaves exactly as before. Install with
# `uv tool install mempalace` (or pipx/pip).
MEMPALACE_BIN = os.environ.get("SIVA_MEMPALACE_BIN", "mempalace-mcp")
MEMPALACE_PALACE = os.environ.get("SIVA_PALACE", "")   # "" => mempalace default (~/.mempalace/palace)
# NixOS + nix-ld: stable location of the nix-ld shared libs, used as a fallback
# when NIX_LD_LIBRARY_PATH isn't in the daemon's own environment (see _spawn).
NIX_LD_LIB_FALLBACK = "/run/current-system/sw/share/nix-ld/lib"
MEMORY_WING = os.environ.get("SIVA_MEMORY_WING", "user")  # wing SIVA files its own memories under
MEMORY_AUTORECALL = os.environ.get("SIVA_MEMORY_AUTORECALL", "1").lower() not in ("0", "false", "no")

# ── Web search (local SearXNG) ────────────────────────────────────────────
# SIVA can retrieve live web results through the user's own SearXNG metasearch
# instance (private, localhost-only, no API keys). The web_search tool queries
# its JSON API for the top hits and pulls readable text from the leading pages,
# so the model reasons over real fetched content — a small local RAG loop.
# Fail-soft: if SearXNG is unreachable the tool returns an error and SIVA
# carries on. Point elsewhere with SIVA_SEARXNG.
SEARXNG_URL = os.environ.get("SIVA_SEARXNG", "http://127.0.0.1:8888").rstrip("/")
# The llama server runs at a deliberately small 4096-token context (VRAM
# headroom on the 4090 — see siva-llm), so the web_search payload must stay
# lean or the follow-up completion overflows. Keep snippets short and fetch
# just the top page's gist.
WEB_FETCH_PAGES = 1       # how many top results to fetch full text from
WEB_FETCH_CHARS = 700     # per-page text budget handed to the model
WEB_SNIPPET_CHARS = 200   # per-result snippet budget
WEB_UA = "Mozilla/5.0 (X11; Linux x86_64) SIVA/1.0"

# ── Social mode (hands-free conversation) ─────────────────────────────────
# A continuous, low-latency chat loop entered by saying "activate social mode".
# It endpoints speech itself (energy VAD — no push-to-talk), runs a fast
# tool-free completion, and streams the reply to TTS sentence by sentence, so
# it feels like just talking. Tunable via env for different mics/rooms.
CONV_ONSET = int(os.environ.get("SIVA_VAD_ONSET", "600"))     # |sample| that counts as speech starting
CONV_SILENCE = int(os.environ.get("SIVA_VAD_SILENCE", "350"))  # below this is silence
CONV_END_SIL = float(os.environ.get("SIVA_VAD_ENDSIL", "0.7"))  # trailing silence (s) that ends a turn
CONV_MAX_UTT = float(os.environ.get("SIVA_VAD_MAXUTT", "20"))   # hard cap on one utterance (s)
CONV_WAIT = float(os.environ.get("SIVA_VAD_WAIT", "12"))        # give up waiting for speech after (s)

WHISPER_MODEL = os.path.join(HOME, ".local/share/siva/ggml-base.en.bin")
WHISPER_FALLBACK = os.path.join(HOME, ".local/share/voice-type/models/ggml-tiny.bin")
