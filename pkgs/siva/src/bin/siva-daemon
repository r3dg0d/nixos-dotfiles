def log(*a):
    with open(LOG, "a") as f:
        f.write(f"[{time.strftime('%H:%M:%S')}] {' '.join(str(x) for x in a)}\n")


def sh(cmd, timeout=15, env=None, binary=False):
    """Run a command, return (rc, stdout)."""
    try:
        p = subprocess.run(cmd, capture_output=True, timeout=timeout, env=env)
        out = p.stdout if binary else p.stdout.decode(errors="replace").strip()
        if p.returncode != 0:
            log("cmd failed", cmd, p.stderr.decode(errors="replace")[:300])
        return p.returncode, out
    except Exception as e:
        log("cmd error", cmd, e)
        return 1, b"" if binary else str(e)


class Broadcaster:
    """Fan-out of JSON lines to every connected UI client."""

    def __init__(self):
        self.clients = []
        self.lock = threading.Lock()

    def add(self, conn):
        with self.lock:
            self.clients.append(conn)

    def send(self, obj):
        data = (json.dumps(obj) + "\n").encode()
        with self.lock:
            dead = []
            for c in self.clients:
                try:
                    c.sendall(data)
                except OSError:
                    dead.append(c)
            for c in dead:
                self.clients.remove(c)


class MemPalace:
    """Durable cross-session memory backed by a MemPalace `mempalace-mcp`
    subprocess (MCP over stdio: newline-delimited JSON-RPC 2.0 — the same
    framing SIVA speaks on its own UI socket).

    One long-lived child process keeps the embedding model warm, so recall is
    fast after the first (cold) call. A single background reader thread pumps
    the child's stdout and dispatches each response to the request waiting on
    its id; stderr is drained to the daemon log.

    Fail-soft throughout: if `mempalace-mcp` is not on PATH, or the handshake
    or any call fails, `available` flips False and every method returns a soft
    {"ok": False, ...} — SIVA keeps working, just without memory."""

    PROTOCOL_VERSION = "2025-06-18"

    def __init__(self, palace_path=""):
        self.palace_path = palace_path
        self.proc = None
        self.ready = False
        self.available = shutil.which(MEMPALACE_BIN) is not None
        self._io_lock = threading.Lock()      # serialize writes to the child's stdin
        self._start_lock = threading.Lock()   # one starter at a time
        self._id = 0
        self._pending = {}                     # request id -> {"ev", "resp"}

    # ── process lifecycle ─────────────────────────────────────────────
    def _spawn(self):
        cmd = [MEMPALACE_BIN]
        if self.palace_path:
            cmd += ["--palace", self.palace_path]
        env = {**os.environ, "MEMPALACE_MCP_IDLE_HOURS": "0"}  # never idle-exit under us
        # NixOS + nix-ld: mempalace's numpy/onnxruntime/chromadb are generic
        # wheels whose C-extensions dlopen libstdc++ (etc.) via the standard
        # LD_LIBRARY_PATH — nix-ld's own NIX_LD_LIBRARY_PATH only covers the main
        # executable, not these later loads. Fold the nix-ld lib dir into
        # LD_LIBRARY_PATH so they resolve. No-op on systems without nix-ld.
        nix_ld = os.environ.get("NIX_LD_LIBRARY_PATH") or (
            NIX_LD_LIB_FALLBACK if os.path.isdir(NIX_LD_LIB_FALLBACK) else "")
        if nix_ld:
            env["LD_LIBRARY_PATH"] = os.pathsep.join(
                p for p in (env.get("LD_LIBRARY_PATH", ""), nix_ld) if p)
        # Run from HOME: MemPalace (pydantic-settings) probes for a .env in the
        # cwd at startup, so an unreadable cwd (e.g. the daemon was launched from
        # a locked-down dir) would crash it. HOME is always readable by us.
        self.proc = subprocess.Popen(
            cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, bufsize=1, env=env, cwd=HOME)
        threading.Thread(target=self._reader, args=(self.proc,), daemon=True).start()
        threading.Thread(target=self._drain_stderr, args=(self.proc,), daemon=True).start()

    def _reader(self, proc):
        for raw in proc.stdout:
            line = raw.strip()
            if not line:
                continue
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                continue
            slot = self._pending.get(msg.get("id"))
            if slot:
                slot["resp"] = msg
                slot["ev"].set()

    def _drain_stderr(self, proc):
        for raw in proc.stderr:
            line = raw.rstrip()
            if line:
                log("mempalace:", line[:200])

    def start(self):
        """Idempotently bring the child up and complete the MCP handshake.
        Returns True once ready. Safe to call from many threads / every turn."""
        if not self.available:
            return False
        if self.ready and self.proc and self.proc.poll() is None:
            return True
        with self._start_lock:
            if self.ready and self.proc and self.proc.poll() is None:
                return True
            self.ready = False
            try:
                self._spawn()
                # cold start loads chromadb + the embedding model — be patient
                resp = self._request("initialize", {
                    "protocolVersion": self.PROTOCOL_VERSION,
                    "capabilities": {},
                    "clientInfo": {"name": "siva", "version": "1.0"},
                }, timeout=90)
                if not resp or "result" not in resp:
                    raise RuntimeError(f"initialize failed: {resp}")
                self._notify("notifications/initialized", {})
                self.ready = True
                log("mempalace ready:", resp["result"].get("serverInfo"))
                return True
            except Exception as e:
                log("mempalace start failed:", repr(e))
                self.available = False  # don't hammer a broken/missing backend
                with contextlib.suppress(Exception):
                    self.proc.kill()
                return False

    # ── JSON-RPC plumbing ─────────────────────────────────────────────
    def _send(self, obj):
        with self._io_lock:
            if not self.proc or self.proc.poll() is not None:
                raise RuntimeError("mempalace process not running")
            self.proc.stdin.write(json.dumps(obj) + "\n")
            self.proc.stdin.flush()

    def _notify(self, method, params):
        self._send({"jsonrpc": "2.0", "method": method, "params": params})

    def _request(self, method, params, timeout=20):
        self._id += 1
        rid = self._id
        ev = threading.Event()
        self._pending[rid] = {"ev": ev, "resp": None}
        try:
            self._send({"jsonrpc": "2.0", "id": rid, "method": method, "params": params})
            if not ev.wait(timeout):
                log("mempalace timeout on", method)
                return None
            return self._pending[rid]["resp"]
        finally:
            self._pending.pop(rid, None)

    def _call_tool(self, tool, arguments, timeout=20):
        """Invoke an MCP tool; return the handler's parsed dict result, or a
        soft error dict. MemPalace wraps handler dicts as JSON text in a
        content block, so unwrap content[0].text back into a dict."""
        if not self.start():
            return {"ok": False, "error": "memory backend unavailable"}
        try:
            resp = self._request("tools/call",
                                  {"name": tool, "arguments": arguments}, timeout)
        except Exception as e:
            return {"ok": False, "error": f"memory call failed: {e}"}
        if not resp:
            return {"ok": False, "error": "memory backend timed out"}
        if "error" in resp:
            return {"ok": False, "error": resp["error"].get("message", "mcp error")}
        result = resp.get("result", {})
        for block in result.get("content", []):
            if block.get("type") == "text":
                try:
                    return json.loads(block["text"])
                except (json.JSONDecodeError, TypeError):
                    return {"ok": True, "text": block["text"]}
        return result

    # ── high-level ops used by SIVA ───────────────────────────────────
    def add(self, wing, room, content):
        r = self._call_tool("mempalace_add_drawer",
                             {"wing": wing, "room": room,
                              "content": content, "added_by": "siva"}, timeout=30)
        if r.get("error"):
            return {"ok": False, "error": r["error"]}
        return {"ok": True, "saved": content[:80], "room": room}

    def search(self, query, limit=5):
        r = self._call_tool("mempalace_search",
                            {"query": query[:250], "limit": max(1, min(int(limit), 20))})
        if r.get("error"):
            return {"ok": False, "error": r["error"]}
        hits = []
        for h in r.get("results", []):
            hits.append({"memory": h.get("text") or h.get("content") or "",
                         "topic": h.get("room", ""),
                         "similarity": h.get("similarity")})
        return {"ok": True, "count": len(hits), "memories": hits}

    def recall_context(self, text, limit=3):
        """Return a short [memory] preamble of memories relevant to `text`,
        for silent injection into the turn — or '' if nothing relevant."""
        r = self.search(text, limit)
        mems = [m["memory"].strip() for m in r.get("memories", []) if m.get("memory", "").strip()]
        if not mems:
            return ""
        bullets = "\n".join(f"- {m}" for m in mems[:limit])
        return ("[memory] Things you remember about the user from earlier sessions "
                "(use if relevant; do not read this note aloud):\n" + bullets)


class Siva:
    def __init__(self):
        self.ui = Broadcaster()
        self.memory = MemPalace(MEMPALACE_PALACE)
        self.state = "idle"
        self.rec_proc = None
        self.rec_lock = threading.Lock()
        self.mic_target = None
        self.saved_sink_vol = None
        self.cancel_flag = threading.Event()
        self.turn_lock = threading.Lock()
        # social (hands-free conversation) mode + streaming-TTS control
        self.conv_active = threading.Event()   # social mode loop is running
        self.conv_exit = threading.Event()     # request to leave social mode
        self.tts_stop = threading.Event()      # interrupt current speech (barge-in/cancel)
        self.tts_lock = threading.Lock()
        self.play_proc = None                  # current pw-play process
        self.messages = [{"role": "system", "content": SYSTEM_PROMPT}]
        # agentic live-stream state (drives Stream.qml)
        self.stream_on = False
        self.stream_lock = threading.Lock()
        self.stream_seq = 0
        self.last_cursor = None      # [ax, ay] absolute desktop pixels
        self.last_action = ""        # human-readable current action label

    # ── state / UI helpers ────────────────────────────────────────────
    def set_state(self, s):
        self.state = s
        self.ui.send({"type": "status", "value": s})
        log("state ->", s)

    def error(self, text):
        log("ERROR:", text)
        self.ui.send({"type": "error", "text": text})
        self.set_state("idle")

    # ── audio ─────────────────────────────────────────────────────────
    def list_sources(self):
        """All selectable audio inputs as [{id, name}]. Covers the top-level
        hardware Sources *and* the filter-chain / loopback nodes exposed as
        Audio/Source (e.g. an easyeffects 'deep_eboy_voice' chain, or a
        Scarlett's per-channel Mic1/Mic2 splits) — those live under the
        Filters section and the plain Sources scan misses them, which is how
        a working mic can be invisible to the picker. A synthetic 'System
        default' entry (id "") records from whatever PipeWire calls default.
        Node ids are ephemeral, so callers match on the stable name and
        resolve the id fresh each time."""
        _, out = sh(["wpctl", "status"])
        sources = [{"id": "", "name": "System default"}]
        section = None
        for line in out.splitlines():
            if "Sources:" in line:
                section = "sources"; continue
            if "Filters:" in line:
                section = "filters"; continue
            if any(h in line for h in ("Sinks:", "Devices:", "Streams:")):
                section = None; continue
            if section == "sources":
                # audio sources carry a "[vol: …]" badge; video ones don't
                m = re.search(r"(\d+)\.\s+(.+?)\s*\[vol", line)
                if m:
                    sources.append({"id": m.group(1), "name": m.group(2).strip()})
            elif section == "filters":
                m = re.search(r"(\d+)\.\s+(\S.*?)\s+\[Audio/Source\]", line)
                if m:
                    sources.append({"id": m.group(1), "name": m.group(2).strip()})
        return sources

    def load_mic(self):
        try:
            with open(MIC_FILE) as f:
                return json.load(f).get("name", "")
        except Exception:
            return ""

    def save_mic(self, name):
        os.makedirs(os.path.dirname(MIC_FILE), exist_ok=True)
        with open(MIC_FILE, "w") as f:
            json.dump({"name": name}, f)

    def send_sources(self):
        self.ui.send({"type": "sources",
                      "items": self.list_sources(),
                      "selected": self.load_mic()})

    def find_mic(self):
        """Resolve the input to record from, in priority order:
        1. the user's persisted choice (matched by description name),
        2. a Scarlett/Focusrite hardware source (auto-detect),
        3. the PipeWire default — which can be a dead/virtual node, so it
           is the last resort."""
        sources = self.list_sources()
        saved = self.load_mic()
        if saved == "System default":
            return None, "System default"
        if saved:
            for s in sources:
                if s["name"] == saved:
                    return s["id"], s["name"]
        for s in sources:
            if s["id"] and re.search(r"scarlett|focusrite", s["name"], re.I):
                return s["id"], s["name"]
        return None, "default source"

    def wav_is_silent(self, wav):
        """True if the capture never rises above the noise floor —
        whisper hallucinates words like "you" on silent input."""
        try:
            with contextlib.closing(wave.open(wav, "rb")) as w:
                frames = w.readframes(w.getnframes())
            samples = array.array("h", frames[: len(frames) // 2 * 2])
            return not samples or max(abs(s) for s in samples) < 300
        except Exception:
            return False

    def _duck_audio(self):
        """Halve desktop volume while listening so speaker output doesn't
        bleed into the mic; restored to the exact prior level afterwards."""
        rc, out = sh(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
        m = re.search(r"Volume:\s*([\d.]+)", out)
        if rc == 0 and m and self.saved_sink_vol is None:
            self.saved_sink_vol = m.group(1)
            sh(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@",
                f"{float(m.group(1)) * 0.5:.2f}"])

    def _unduck_audio(self):
        vol, self.saved_sink_vol = self.saved_sink_vol, None
        if vol is not None:
            sh(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", vol])

    def _spawn_rec(self):
        cmd = ["pw-record", "--format", "s16", "--rate", "16000", "--channels", "1", REC_WAV]
        if self.mic_target:
            cmd = ["pw-record", "--target", self.mic_target, "--format", "s16",
                   "--rate", "16000", "--channels", "1", REC_WAV]
        return subprocess.Popen(cmd)

    def _watch_capture(self, proc):
        """pw-record occasionally attaches to a capture stream that only
        delivers zeros (seen when recording starts the instant a previous
        stream tears down). Real input always has a noise floor, so if the
        first second of the file is digital silence, bounce the recorder —
        a fresh stream comes up live."""
        for _ in range(2):
            time.sleep(1.2)
            with self.rec_lock:
                if self.rec_proc is not proc or proc.poll() is not None:
                    return
            try:
                with open(REC_WAV, "rb") as f:
                    data = f.read(65536)[44:]  # skip WAV header
            except OSError:
                data = b""
            samples = array.array("h", data[: len(data) // 2 * 2])
            if samples and any(samples):
                return
            with self.rec_lock:
                if self.rec_proc is not proc:
                    return
                log("capture stream dead (all zeros) — bouncing pw-record")
                proc.send_signal(signal.SIGINT)
                try:
                    proc.wait(timeout=1)
                except subprocess.TimeoutExpired:
                    proc.kill()
                proc = self.rec_proc = self._spawn_rec()
        # still dead after retries: the wav_is_silent guard reports it

    def start_recording(self):
        tid, name = self.find_mic()
        self.mic_target = tid
        self.ui.send({"type": "mic", "device": name})
        try:
            os.unlink(REC_WAV)
        except FileNotFoundError:
            pass
        self._duck_audio()
        with self.rec_lock:
            self.rec_proc = self._spawn_rec()
        threading.Thread(target=self._watch_capture, args=(self.rec_proc,),
                         daemon=True).start()
        self.set_state("listening")

    def stop_recording(self):
        self._unduck_audio()
        with self.rec_lock:
            p, self.rec_proc = self.rec_proc, None
        if not p:
            return None
        p.send_signal(signal.SIGINT)
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            p.terminate()
            p.wait(timeout=2)
        if not (os.path.exists(REC_WAV) and os.path.getsize(REC_WAV) > 8000):
            return None
        return REC_WAV

    def transcribe(self, wav):
        model = WHISPER_MODEL if os.path.exists(WHISPER_MODEL) else WHISPER_FALLBACK
        if not os.path.exists(model):
            self.error("No whisper model found")
            return None
        rc, out = sh(["whisper-cli", "-m", model, "-f", wav, "-l", "en", "-np", "-nt"],
                     timeout=60)
        if rc != 0:
            return None
        text = " ".join(l.strip() for l in out.splitlines()
                        if l.strip() and not l.startswith("["))
        text = re.sub(r"\s+", " ", text).strip()
        return text or None

    # ── streaming text-to-speech ──────────────────────────────────────
    _BOUNDARY_RE = re.compile(r"[.!?…\n]+")

    @staticmethod
    def _find_piper():
        for cand in ("piper", "piper-tts"):
            rc, _ = sh(["which", cand], timeout=5)
            if rc == 0:
                return cand
        return None

    def _tts_interrupted(self):
        return (self.tts_stop.is_set() or self.cancel_flag.is_set()
                or self.conv_exit.is_set())

    def _pop_sentences(self, buf):
        """Split off complete sentences from a running buffer.
        Returns (list_of_sentences, remainder)."""
        sents = []
        while True:
            m = self._BOUNDARY_RE.search(buf)
            if not m:
                break
            s = buf[:m.end()].strip()
            buf = buf[m.end():]
            if s:
                sents.append(s)
        return sents, buf

    def _synth_sentence(self, piper, text, idx):
        """Render one sentence to a wav via piper, then the selected RVC voice
        (if any). Returns a playable wav path or None."""
        wav = f"/tmp/siva-tts-{idx}.wav"
        try:
            p = subprocess.run([piper, "-m", PIPER_VOICE, "-f", wav],
                               input=text.encode(), capture_output=True, timeout=30)
        except Exception as e:
            log("piper error", e)
            return None
        if p.returncode != 0:
            return None
        # keep the user's RVC voice even in the streaming path: convert this
        # one sentence, falling back to plain piper on any error/timeout
        if os.path.exists(os.path.join(HOME, ".local/share/siva/voice.json")):
            rvc_wav = f"/tmp/siva-tts-{idx}r.wav"
            siva_rvc = os.path.join(HOME, ".local/bin/siva-rvc")
            try:
                r = subprocess.run([siva_rvc, wav, rvc_wav],
                                   capture_output=True, timeout=120)
                if r.returncode == 0 and os.path.exists(rvc_wav):
                    return rvc_wav
            except Exception as e:
                log("rvc convert error", e)
        return wav

    def speak_stream(self, source):
        """Speak text as it becomes available. `source` is an iterable of text
        chunks (a single full string, or streaming deltas from the LLM). We
        synthesize and play sentence-by-sentence in a two-stage pipeline — the
        next sentence is rendered while the current one plays — so the first
        words are heard almost immediately instead of after the whole reply.
        Blocks until playback finishes or speech is interrupted."""
        piper = self._find_piper()
        if not piper or not os.path.exists(PIPER_VOICE):
            for _ in source:      # still drain the generator (drives UI/history)
                pass
            return
        self.tts_stop.clear()
        self.set_state("speaking")
        play_q = queue.Queue()
        n = [0]

        def synth_worker():
            buf = ""
            try:
                for chunk in source:
                    if self._tts_interrupted():
                        break
                    buf += chunk
                    sents, buf = self._pop_sentences(buf)
                    for s in sents:
                        if self._tts_interrupted():
                            buf = ""
                            break
                        n[0] += 1
                        w = self._synth_sentence(piper, s, n[0])
                        if w:
                            play_q.put(w)
                if buf.strip() and not self._tts_interrupted():
                    n[0] += 1
                    w = self._synth_sentence(piper, buf.strip(), n[0])
                    if w:
                        play_q.put(w)
            finally:
                play_q.put(None)   # sentinel: no more audio

        t = threading.Thread(target=synth_worker, daemon=True)
        t.start()
        try:
            while True:
                w = play_q.get()
                if w is None:
                    break
                if self._tts_interrupted():
                    continue       # drain remaining wavs without playing
                try:
                    with self.tts_lock:
                        self.play_proc = subprocess.Popen(["pw-play", w])
                    while True:
                        try:
                            self.play_proc.wait(timeout=0.1)
                            break
                        except subprocess.TimeoutExpired:
                            if self._tts_interrupted():
                                self.play_proc.terminate()
                                break
                except Exception as e:
                    log("play error", e)
                finally:
                    with self.tts_lock:
                        self.play_proc = None
                    try:
                        os.unlink(w)
                    except OSError:
                        pass
        finally:
            t.join(timeout=2)

    def speak(self, text):
        """Speak a complete string (still pipelined sentence-by-sentence)."""
        if text and text.strip():
            self.speak_stream(iter([text]))

    # ── social mode (hands-free conversation) ─────────────────────────
    _ENTER_RE = re.compile(
        r"\b(activate|enter|start|begin|enable|turn on|go(?:ing)? into|"
        r"switch to|let'?s do)\b[^.?!]*\bsocial mode\b", re.I)
    _EXIT_RE = re.compile(
        r"\b(exit|leave|end|stop|deactivate|disable|quit|close|turn off)\b"
        r"[^.?!]*\bsocial mode\b|\b(good ?bye|that'?s all|that is all|"
        r"we'?re done|i'?m done)\b", re.I)

    def is_enter_conversation(self, text):
        return bool(self._ENTER_RE.search(text or ""))

    def _is_exit_conversation(self, text):
        return bool(self._EXIT_RE.search(text or ""))

    def _vad_record(self):
        """Capture one utterance hands-free: wait for speech to start, then
        record until a stretch of trailing silence ends it. Returns a 16 kHz
        mono wav path, or None if nobody spoke / social mode is exiting."""
        tid, _ = self.find_mic()
        self.mic_target = tid
        self.set_state("listening")
        cmd = ["pw-record", "--format", "s16", "--rate", "16000",
               "--channels", "1", "-"]
        if tid:
            cmd[1:1] = ["--target", tid]
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE)
        step = 1280 * 2                     # 80 ms frames
        frames, started, silent, t0 = [], False, 0.0, time.time()
        try:
            while True:
                if self.conv_exit.is_set():
                    return None
                data = proc.stdout.read(step)
                if not data or len(data) < step:
                    break
                peak = max((abs(s) for s in array.array("h", data)), default=0)
                frames.append(data)
                if not started:
                    if peak >= CONV_ONSET:
                        started = True
                        frames = frames[-4:]        # keep a little pre-roll
                    elif time.time() - t0 > CONV_WAIT:
                        return None                 # nobody spoke
                    elif len(frames) > 40:
                        frames = frames[-8:]        # bound idle buffer
                else:
                    if peak >= CONV_SILENCE:
                        silent = 0.0
                    else:
                        silent += 0.08
                        if silent >= CONV_END_SIL:
                            break
                    if time.time() - t0 > CONV_MAX_UTT + CONV_WAIT:
                        break
        finally:
            proc.send_signal(signal.SIGINT)
            try:
                proc.wait(timeout=1)
            except subprocess.TimeoutExpired:
                proc.kill()
        if not started:
            return None
        wav = "/tmp/siva-conv.wav"
        with contextlib.closing(wave.open(wav, "wb")) as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(16000)
            w.writeframes(b"".join(frames))
        return wav

    def chat_stream(self, messages):
        """Fast, tool-free streaming completion for social mode. Yields plain
        content deltas as they arrive (no <reply> protocol, no tools) so we can
        start speaking the moment the first sentence lands.

        Crucially it disables gemma's chain-of-thought (enable_thinking=false):
        this model is a reasoning model that otherwise streams its thinking into
        a separate `reasoning_content` channel and only commits the answer to
        `content` after it finishes — which both delays and can eat the whole
        token budget. Turning thinking off drops a short reply from ~2-3 s of
        thinking to ~0.4 s of direct answer."""
        body = json.dumps({"model": "siva", "stream": True, "messages": messages,
                           "temperature": 0.7, "max_tokens": 300,
                           "chat_template_kwargs": {"enable_thinking": False}})
        conn = http.client.HTTPConnection(LLAMA_HOST, LLAMA_PORT, timeout=120)
        try:
            conn.request("POST", "/v1/chat/completions", body,
                         {"Content-Type": "application/json"})
            resp = conn.getresponse()
            if resp.status != 200:
                log("chat_stream HTTP", resp.status)
                return
            buf = b""
            while True:
                if self.conv_exit.is_set() or self.tts_stop.is_set():
                    break
                chunk = resp.read1(65536)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    line = line.strip()
                    if not line.startswith(b"data:"):
                        continue
                    payload = line[5:].strip()
                    if payload == b"[DONE]":
                        return
                    try:
                        delta = json.loads(payload)["choices"][0]["delta"]
                    except (KeyError, IndexError, json.JSONDecodeError):
                        continue
                    if delta.get("content"):
                        yield delta["content"]
        finally:
            conn.close()

    def conversation_loop(self):
        """Hands-free social mode: listen (VAD) → fast chat → streamed TTS,
        looping until the user says an exit phrase or presses F8. Holds the
        turn lock for the whole session so normal turns can't interleave."""
        if not self.turn_lock.acquire(blocking=False):
            return
        self.conv_active.set()
        self.conv_exit.clear()
        self.cancel_flag.clear()
        try:
            conv = [{"role": "system", "content": CONV_PROMPT}]
            self.ui.send({"type": "show"})
            self.ui.send({"type": "cot_clear"})
            self.ui.send({"type": "reply_clear"})
            self.ui.send({"type": "transcript", "text": "[social mode]"})
            self.speak_stream(iter(["Social mode on. What's up?"]))
            empties = 0
            while not self.conv_exit.is_set():
                wav = self._vad_record()
                if self.conv_exit.is_set():
                    break
                if not wav:
                    empties += 1
                    if empties >= 2:          # two quiet waits → bow out
                        break
                    continue
                empties = 0
                if self.wav_is_silent(wav):
                    continue
                text = self.transcribe(wav)
                if not text:
                    continue
                self.ui.send({"type": "transcript", "text": text})
                if self._is_exit_conversation(text):
                    break
                conv.append({"role": "user", "content": text})
                if len(conv) > 21:            # keep history bounded
                    conv = [conv[0]] + conv[-18:]
                self.set_state("thinking")
                self.ui.send({"type": "reply_clear"})
                parts = []

                def gen():
                    for d in self.chat_stream(conv):
                        parts.append(d)
                        self.ui.send({"type": "reply", "text": d})
                        yield d

                self.speak_stream(gen())
                conv.append({"role": "assistant",
                             "content": "".join(parts).strip() or "..."})
            self.speak_stream(iter(["Leaving social mode. Talk soon!"]))
        except Exception as e:
            self.error(f"conversation: {type(e).__name__}: {e}")
        finally:
            self.conv_active.clear()
            self.conv_exit.clear()
            self.tts_stop.clear()
            self.set_state("idle")
            self.turn_lock.release()

    # ── screen capture ────────────────────────────────────────────────
    def grab_frame(self, output="focused"):
        """Return a base64 data-URI of one screen frame, downscaled 50%."""
        args = ["grim", "-s", "0.5", "-t", "png"]
        if output == "focused":
            rc, out = sh(["niri", "msg", "-j", "focused-output"])
            try:
                name = json.loads(out)["name"]
                args += ["-o", name]
            except Exception:
                pass
        elif output in ("DP-1", "DP-2"):
            args += ["-o", output]
        args += ["-"]
        rc, png = sh(args, timeout=10, binary=True)
        if rc != 0 or not png:
            return None
        return "data:image/png;base64," + base64.b64encode(png).decode()

    # ── OCR click-by-text ─────────────────────────────────────────────
    def ocr_find(self, png_path, target):
        """Locate `target` text on a captured monitor image and return the
        pixel centre (x, y) of the best match, or None. Uses tesseract TSV
        (word boxes + confidence). Matches, in order of preference: an exact
        word, a consecutive multi-word run on one line whose text contains
        the target, then a loose single-word substring."""
        rc, out = sh(["tesseract", png_path, "stdout", "--psm", "11", "-l", "eng", "tsv"],
                     timeout=30)
        if rc != 0 or not out:
            return None
        words = []
        for row in out.splitlines()[1:]:
            f = row.split("\t")
            if len(f) < 12:
                continue
            try:
                conf = float(f[10])
            except ValueError:
                continue
            txt = f[11].strip()
            if not txt or conf < OCR_MIN_CONF:
                continue
            words.append({"t": txt, "l": int(f[6]), "y": int(f[7]),
                          "w": int(f[8]), "h": int(f[9]),
                          "line": (f[1], f[2], f[3], f[4])})
        if not words:
            return None
        tl = target.lower().strip()

        def centre(ws):
            l = min(w["l"] for w in ws); t = min(w["y"] for w in ws)
            r = max(w["l"] + w["w"] for w in ws); b = max(w["y"] + w["h"] for w in ws)
            return ((l + r) // 2, (t + b) // 2)

        # 1. exact single-word hit
        for w in words:
            if w["t"].lower() == tl:
                return centre([w])
        # 2. consecutive words on the same line that contain the phrase
        lines = {}
        for w in words:
            lines.setdefault(w["line"], []).append(w)
        toks = tl.split()
        for ws in lines.values():
            ws.sort(key=lambda w: w["l"])
            joined = " ".join(w["t"].lower() for w in ws)
            if tl in joined:
                start = next((i for i, w in enumerate(ws)
                              if toks[0] in w["t"].lower()), 0)
                span = ws[start:start + len(toks)] or ws
                return centre(span)
        # 3. loose single-word substring
        for w in words:
            if tl in w["t"].lower():
                return centre([w])
        return None

    # ── live agentic stream (dual-monitor feed for Stream.qml) ─────────
    def start_stream(self):
        with self.stream_lock:
            if self.stream_on:
                return
            self.stream_on = True
            self.stream_seq = 0
        os.makedirs(STREAM_DIR, exist_ok=True)
        self.ui.send({"type": "agent_start", "monitors": [
            {"id": mid, "label": g["label"], "w": g["w"], "h": g["h"],
             "x": g["x"]} for mid, g in MONITORS.items()]})
        threading.Thread(target=self._stream_loop, daemon=True).start()

    def _stream_loop(self):
        while self.stream_on:
            for mid in MONITORS:
                sh(["grim", "-o", mid, "-s", "0.25", os.path.join(STREAM_DIR, f"{mid}.png")],
                   timeout=6)
            self.stream_seq += 1
            self.ui.send({"type": "frame", "seq": self.stream_seq,
                          "cursor": list(self.last_cursor) if self.last_cursor else None,
                          "action": self.last_action})
            time.sleep(0.6)

    def stop_stream(self):
        with self.stream_lock:
            if not self.stream_on:
                return
            self.stream_on = False
        self.ui.send({"type": "agent_stop"})

    # ── tool execution ────────────────────────────────────────────────
    def run_tool(self, name, args):
        log("tool", name, args)
        if name == "switch_window":
            d = args.get("direction", "right")
            sh(["niri", "msg", "action",
                "focus-column-left" if d == "left" else "focus-column-right"])
            return {"ok": True, "action": f"focused column to the {d}"}

        if name == "focus_workspace":
            sh(["niri", "msg", "action", "focus-workspace", str(args.get("index", 1))])
            return {"ok": True}

        if name == "list_windows":
            rc, out = sh(["niri", "msg", "-j", "windows"])
            if rc != 0:
                return {"ok": False, "error": out[:200]}
            # niri reports an internal workspace_id; map it to the 1-9 index
            ws_idx = {}
            rc2, wout = sh(["niri", "msg", "-j", "workspaces"])
            if rc2 == 0:
                try:
                    ws_idx = {w["id"]: w["idx"] for w in json.loads(wout)}
                except (json.JSONDecodeError, KeyError):
                    pass
            try:
                wins = json.loads(out)
            except json.JSONDecodeError:
                return {"ok": False, "error": "unparseable niri msg output"}
            return {"ok": True, "windows": [
                {"id": w["id"],
                 "title": (w.get("title") or "")[:120],
                 "app": w.get("app_id") or "",
                 "workspace": ws_idx.get(w.get("workspace_id")),
                 "focused": w.get("is_focused", False)}
                for w in wins]}

        if name == "focus_window":
            rc, out = sh(["niri", "msg", "action", "focus-window",
                          "--id", str(int(args["id"]))])
            return {"ok": rc == 0} if rc == 0 else {"ok": False, "error": out[:200]}

        if name == "move_cursor":
            x, y = int(args["x"]), int(args["y"])
            rc, _ = sh(["ydotool", "mousemove", "--absolute", "-x", str(x), "-y", str(y)],
                       env=YDOTOOL_ENV)
            self.last_cursor = [x, y]
            return {"ok": rc == 0, "cursor": [x, y]}

        if name == "click_text":
            target = (args.get("text") or "").strip()
            if not target:
                return {"ok": False, "error": "no text given"}
            mon = args.get("monitor", "focused")
            if mon == "focused":
                rc, out = sh(["niri", "msg", "-j", "focused-output"])
                try:
                    mon = json.loads(out)["name"]
                except Exception:
                    mon = "DP-1"
            if mon not in MONITORS:
                mon = "DP-1"
            png = "/tmp/siva-ocr.png"
            rc, _ = sh(["grim", "-o", mon, png], timeout=8)
            if rc != 0:
                return {"ok": False, "error": f"could not capture {mon}"}
            hit = self.ocr_find(png, target)
            if not hit:
                return {"ok": False, "error": f"text '{target}' not found on {mon}; "
                        "screenshot and try different/visible text or move_cursor"}
            ax = MONITORS[mon]["x"] + int(hit[0])
            ay = MONITORS[mon]["y"] + int(hit[1])
            sh(["ydotool", "mousemove", "--absolute", "-x", str(ax), "-y", str(ay)],
               env=YDOTOOL_ENV)
            self.last_cursor = [ax, ay]
            time.sleep(0.15)
            code = {"left": "0xC0", "right": "0xC1", "middle": "0xC2"}[args.get("button", "left")]
            n = 2 if args.get("double") else 1
            for _ in range(n):
                rc, _ = sh(["ydotool", "click", code], env=YDOTOOL_ENV)
                time.sleep(0.08)
            return {"ok": rc == 0, "clicked": target, "monitor": mon, "cursor": [ax, ay]}

        if name == "click":
            code = {"left": "0xC0", "right": "0xC1", "middle": "0xC2"}[args.get("button", "left")]
            n = 2 if args.get("double") else 1
            for _ in range(n):
                rc, _ = sh(["ydotool", "click", code], env=YDOTOOL_ENV)
                time.sleep(0.08)
            return {"ok": rc == 0}

        if name == "scroll":
            amt = int(args.get("amount", -3))
            rc, _ = sh(["ydotool", "mousemove", "--wheel", "-x", "0", "-y", str(amt)],
                       env=YDOTOOL_ENV)
            return {"ok": rc == 0}

        if name == "type_text":
            text = args.get("text", "")
            p = subprocess.run(["wtype", "-"], input=text.encode(),
                               capture_output=True, timeout=30)
            if p.returncode == 0:
                return {"ok": True, "via": "wtype"}
            # wtype failed (e.g. a game / XWayland app ignoring the virtual
            # keyboard) — fall back to kernel-level typing, which they see
            rc, _ = sh(["ydotool", "type", "--", text], env=YDOTOOL_ENV, timeout=30)
            return {"ok": rc == 0, "via": "ydotool"}

        if name == "game_control":
            acts = args.get("actions") or []
            steps = 0
            for a in acts[:64]:                     # cap sequence length
                if not isinstance(a, dict):
                    continue
                if "hold" in a:
                    code = KEYCODES.get(str(a["hold"]).lower())
                    if code is None:
                        continue
                    ms = max(0, min(int(a.get("ms", 300)), 15000))
                    sh(["ydotool", "key", f"{code}:1"], env=YDOTOOL_ENV)
                    time.sleep(ms / 1000)
                    sh(["ydotool", "key", f"{code}:0"], env=YDOTOOL_ENV)
                elif "tap" in a:
                    code = KEYCODES.get(str(a["tap"]).lower())
                    if code is not None:
                        sh(["ydotool", "key", f"{code}:1", f"{code}:0"], env=YDOTOOL_ENV)
                elif "key_down" in a:
                    code = KEYCODES.get(str(a["key_down"]).lower())
                    if code is not None:
                        sh(["ydotool", "key", f"{code}:1"], env=YDOTOOL_ENV)
                elif "key_up" in a:
                    code = KEYCODES.get(str(a["key_up"]).lower())
                    if code is not None:
                        sh(["ydotool", "key", f"{code}:0"], env=YDOTOOL_ENV)
                elif "mouse_move" in a and isinstance(a["mouse_move"], list) \
                        and len(a["mouse_move"]) == 2:
                    dx, dy = int(a["mouse_move"][0]), int(a["mouse_move"][1])
                    sh(["ydotool", "mousemove", "-x", str(dx), "-y", str(dy)],
                       env=YDOTOOL_ENV)          # relative (no --absolute) = camera/aim
                elif "mouse_click" in a and a["mouse_click"] in MOUSE_CLICK:
                    sh(["ydotool", "click", MOUSE_CLICK[a["mouse_click"]]], env=YDOTOOL_ENV)
                elif "mouse_down" in a and a["mouse_down"] in MOUSE_DN:
                    sh(["ydotool", "click", MOUSE_DN[a["mouse_down"]]], env=YDOTOOL_ENV)
                elif "mouse_up" in a and a["mouse_up"] in MOUSE_UP:
                    sh(["ydotool", "click", MOUSE_UP[a["mouse_up"]]], env=YDOTOOL_ENV)
                elif "text" in a:
                    sh(["ydotool", "type", "--", str(a["text"])], env=YDOTOOL_ENV, timeout=30)
                elif "ms" in a:
                    time.sleep(max(0, min(int(a["ms"]), 15000)) / 1000)
                else:
                    continue
                steps += 1
            return {"ok": True, "steps": steps}

        if name == "press_key":
            combo = args["key"].strip()
            parts = [p.strip() for p in combo.split("+")]
            mods, key = parts[:-1], parts[-1]
            modmap = {"ctrl": "ctrl", "control": "ctrl", "shift": "shift",
                      "alt": "alt", "super": "logo", "mod": "logo", "logo": "logo"}
            cmd = ["wtype"]
            for m in mods:
                cmd += ["-M", modmap.get(m.lower(), m.lower())]
            cmd += ["-k", key]
            for m in reversed(mods):
                cmd += ["-m", modmap.get(m.lower(), m.lower())]
            rc, _ = sh(cmd)
            return {"ok": rc == 0}

        if name == "screenshot":
            uri = self.grab_frame(args.get("output", "focused"))
            if not uri:
                return {"ok": False, "error": "capture failed"}
            return {"ok": True, "_frames": [uri]}

        if name == "vision_loop":
            n = min(int(args.get("frames", 3)), 4)
            iv = int(args.get("interval_ms", 500)) / 1000
            frames = []
            for i in range(n):
                uri = self.grab_frame(args.get("output", "focused"))
                if uri:
                    frames.append(uri)
                if i < n - 1:
                    time.sleep(iv)
            return {"ok": bool(frames), "captured": len(frames), "_frames": frames}

        if name == "spawn_app":
            cmd = args.get("command", "")
            if not re.fullmatch(r"[\w./-]+", cmd):
                return {"ok": False, "error": "plain command names only"}
            sh(["niri", "msg", "action", "spawn", "--", cmd])
            return {"ok": True, "spawned": cmd}

        if name == "remember":
            content = (args.get("content") or "").strip()
            if not content:
                return {"ok": False, "error": "nothing to remember"}
            # room = a filesystem-safe topic slug; wing groups all of SIVA's own memories
            topic = re.sub(r"[^\w-]+", "-", (args.get("topic") or "general").strip().lower())
            topic = topic.strip("-") or "general"
            return self.memory.add(MEMORY_WING, topic, content)

        if name == "recall":
            query = (args.get("query") or "").strip()
            if not query:
                return {"ok": False, "error": "empty query"}
            return self.memory.search(query, args.get("limit", 5))

        if name == "web_search":
            query = (args.get("query") or "").strip()
            if not query:
                return {"ok": False, "error": "empty query"}
            return self.web_search(query, int(args.get("num_results", 4)))

        return {"ok": False, "error": f"unknown tool {name}"}

    # ── web search (local SearXNG RAG) ────────────────────────────────
    @staticmethod
    def _http_get(url, timeout, max_bytes):
        req = urllib.request.Request(url, headers={
            "User-Agent": WEB_UA, "Accept": "*/*"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            ctype = r.headers.get("Content-Type", "")
            return r.read(max_bytes), ctype

    @staticmethod
    def _html_to_text(raw):
        """Very small HTML→text: drop script/style, strip tags, unescape
        entities, collapse whitespace. Good enough to feed a page's gist to
        the model without pulling in a parser dependency."""
        try:
            s = raw.decode("utf-8", "replace")
        except Exception:
            return ""
        s = re.sub(r"(?is)<(script|style|noscript|svg|head)[^>]*>.*?</\1>", " ", s)
        s = re.sub(r"(?s)<[^>]+>", " ", s)
        s = htmllib.unescape(s)
        return re.sub(r"\s+", " ", s).strip()

    def _fetch_page_text(self, url):
        try:
            raw, ctype = self._http_get(url, timeout=6, max_bytes=600_000)
        except Exception:
            return ""
        if "html" not in ctype and "text" not in ctype and ctype:
            return ""
        return self._html_to_text(raw)[:WEB_FETCH_CHARS]

    def web_search(self, query, num_results=4):
        num_results = max(1, min(num_results, 6))
        url = SEARXNG_URL + "/search?" + urllib.parse.urlencode({
            "q": query, "format": "json", "safesearch": "0"})
        try:
            raw, _ = self._http_get(url, timeout=12, max_bytes=1_500_000)
            data = json.loads(raw.decode("utf-8", "replace"))
        except urllib.error.HTTPError as e:
            hint = " — enable the json format in SearXNG (search.formats)" if e.code == 403 else ""
            return {"ok": False, "error": f"SearXNG HTTP {e.code}{hint}"}
        except Exception as e:
            return {"ok": False, "error": f"SearXNG unreachable at {SEARXNG_URL}: {e}"}

        hits = data.get("results") or []
        results = []
        for r in hits[:num_results]:
            results.append({
                "title": (r.get("title") or "").strip()[:120],
                "url": r.get("url") or "",
                "snippet": re.sub(r"\s+", " ", (r.get("content") or "")).strip()[:WEB_SNIPPET_CHARS],
            })
        if not results:
            ans = data.get("answers") or []
            if ans:
                return {"ok": True, "query": query, "answer": " ".join(ans)[:800],
                        "results": []}
            return {"ok": False, "error": f"no results for {query!r}"}

        # RAG step: pull readable text from the leading pages so the model
        # reasons over real content, not just snippets. Fail-soft per page.
        for r in results[:WEB_FETCH_PAGES]:
            if r["url"]:
                text = self._fetch_page_text(r["url"])
                if text:
                    r["content"] = text
        out = {"ok": True, "query": query, "results": results}
        if data.get("answers"):
            out["answer"] = " ".join(data["answers"])[:800]
        return out

    # ── llama.cpp streaming ───────────────────────────────────────────
    def llm_stream(self, messages):
        """One streaming chat completion. Yields ('cot'|'reply', delta) text
        events, routing on <reply> tags; returns (full_content, tool_calls)."""
        body = json.dumps({
            "model": "siva", "stream": True, "messages": messages,
            "tools": TOOLS, "temperature": 0.6, "max_tokens": 2048,
        })
        conn = http.client.HTTPConnection(LLAMA_HOST, LLAMA_PORT, timeout=300)
        conn.request("POST", "/v1/chat/completions", body,
                     {"Content-Type": "application/json"})
        resp = conn.getresponse()
        if resp.status != 200:
            raise RuntimeError(f"llama-server HTTP {resp.status}: {resp.read()[:200]}")

        content = ""
        tool_calls = {}
        pending = ""      # holdback buffer for tag detection
        in_reply = False

        def route(txt):
            nonlocal pending, in_reply
            pending += txt
            while True:
                if in_reply:
                    idx = pending.find("</reply>")
                    if idx >= 0:
                        if idx:
                            self.ui.send({"type": "reply", "text": pending[:idx]})
                        pending = pending[idx + len("</reply>"):]
                        in_reply = False
                        continue
                    # emit all but a potential partial closing tag
                    keep = 0
                    for k in range(min(len("</reply>") - 1, len(pending)), 0, -1):
                        if "</reply>".startswith(pending[-k:]):
                            keep = k
                            break
                    emit = pending[:len(pending) - keep]
                    if emit:
                        self.ui.send({"type": "reply", "text": emit})
                    pending = pending[len(pending) - keep:]
                    return
                idx = pending.find("<reply>")
                if idx >= 0:
                    if pending[:idx].strip():
                        self.ui.send({"type": "cot", "text": pending[:idx]})
                    pending = pending[idx + len("<reply>"):]
                    in_reply = True
                    continue
                keep = 0
                for k in range(min(len("<reply>") - 1, len(pending)), 0, -1):
                    if "<reply>".startswith(pending[-k:]):
                        keep = k
                        break
                emit = pending[:len(pending) - keep]
                if emit:
                    self.ui.send({"type": "cot", "text": emit})
                pending = pending[len(pending) - keep:]
                return

        buf = b""
        while True:
            if self.cancel_flag.is_set():
                conn.close()
                raise InterruptedError
            chunk = resp.read1(65536)
            if not chunk:
                break
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                line = line.strip()
                if not line.startswith(b"data:"):
                    continue
                payload = line[5:].strip()
                if payload == b"[DONE]":
                    buf = b""
                    break
                try:
                    delta = json.loads(payload)["choices"][0]["delta"]
                except (KeyError, IndexError, json.JSONDecodeError):
                    continue
                # some servers stream reasoning separately; send straight to CoT
                if delta.get("reasoning_content"):
                    self.ui.send({"type": "cot", "text": delta["reasoning_content"]})
                if delta.get("content"):
                    content += delta["content"]
                    route(delta["content"])
                for tc in delta.get("tool_calls") or []:
                    i = tc.get("index", 0)
                    slot = tool_calls.setdefault(
                        i, {"id": tc.get("id", f"call_{i}"),
                            "type": "function",
                            "function": {"name": "", "arguments": ""}})
                    fn = tc.get("function", {})
                    if fn.get("name"):
                        slot["function"]["name"] += fn["name"]
                    if fn.get("arguments"):
                        slot["function"]["arguments"] += fn["arguments"]
        if pending.strip():
            self.ui.send({"type": "reply" if in_reply else "cot", "text": pending})
        conn.close()
        return content, [tool_calls[i] for i in sorted(tool_calls)]

    # ── agent turn ────────────────────────────────────────────────────
    # ── context-window management ─────────────────────────────────────
    def _est_tokens(self, messages):
        """Conservative estimate of the prompt tokens for `messages` plus the
        always-present tool schemas. ~4 chars/token slightly over-counts, which
        is what we want — it biases us toward trimming a touch early rather than
        overflowing the model's hard context limit."""
        if not hasattr(self, "_tools_chars"):
            self._tools_chars = len(json.dumps(TOOLS))
        chars = self._tools_chars
        for m in messages:
            c = m.get("content")
            if isinstance(c, list):
                for p in c:
                    chars += len(p.get("text", "")) if p.get("type") == "text" else 5000
            elif c:
                chars += len(c)
            for tc in m.get("tool_calls") or []:
                chars += len(json.dumps(tc))
            chars += 24                       # per-message role/framing overhead
        return int(chars / 4.2)               # ~4.2 chars/token for this mixed content

    def _fit_context(self, reserve=CTX_REPLY_RESERVE):
        """Drop the OLDEST conversation turns (never the system prompt) until the
        prompt fits, keeping history starting on a user turn so tool_call/tool
        pairs stay intact. Called with only prior history present (before the
        current turn is appended), so it can't clip the in-progress turn."""
        limit = LLAMA_CTX - reserve
        while len(self.messages) > 1 and self._est_tokens(self.messages) > limit:
            del self.messages[1]
            while len(self.messages) > 1 and self.messages[1].get("role") != "user":
                del self.messages[1]

    def _emergency_trim(self):
        """Last-resort trim used only if a request still overflows: keep the
        system prompt + the current turn (from its last user message on).
        Returns True if it actually dropped anything."""
        for i in range(len(self.messages) - 1, 0, -1):
            if self.messages[i].get("role") == "user" and i > 1:
                self.messages = [self.messages[0]] + self.messages[i:]
                return True
        return False

    def _stream_fitting(self, messages):
        """llm_stream with a safety net: if the server rejects the request for
        exceeding its context, hard-trim and retry once instead of crashing."""
        try:
            return self.llm_stream(messages)
        except RuntimeError as e:
            msg = str(e).lower()
            if ("context" in msg or "exceed" in msg) and self._emergency_trim():
                log("context overflow — emergency-trimmed history, retrying")
                return self.llm_stream(self.messages)
            raise

    def agent_turn(self, user_text):
        if not self.turn_lock.acquire(blocking=False):
            return
        try:
            self.cancel_flag.clear()
            self.ui.send({"type": "transcript", "text": user_text})
            self.ui.send({"type": "cot_clear"})
            self.ui.send({"type": "reply_clear"})
            self.set_state("thinking")

            # drop image payloads from earlier turns (a stale screenshot is huge
            # and rarely useful next turn), then trim oldest turns to fit context
            for m in self.messages:
                if isinstance(m.get("content"), list):
                    m["content"] = [p for p in m["content"] if p.get("type") == "text"] \
                        or [{"type": "text", "text": "[old screen frame omitted]"}]
            self._fit_context()

            # Durable memory: silently seed this turn with anything relevant we
            # saved in past sessions. Prefixed into the user turn (rather than a
            # separate message) so strict user/model alternation is preserved for
            # templates like gemma that require it.
            turn = user_text
            # Only auto-recall once the backend is warm, so a cold embedding-model
            # load never stalls the turn (explicit remember/recall still waits).
            if MEMORY_AUTORECALL and self.memory.ready:
                mem = self.memory.recall_context(user_text)
                if mem:
                    turn = mem + "\n\n" + user_text
                    self.ui.send({"type": "cot", "text": "[recalled memory]\n"})
            self.messages.append({"role": "user", "content": turn})
            reply_text = ""

            for _ in range(MAX_TOOL_ROUNDS):
                content, tool_calls = self._stream_fitting(self.messages)
                msg = {"role": "assistant", "content": content or None}
                if tool_calls:
                    msg["tool_calls"] = tool_calls
                self.messages.append(msg)

                m = re.search(r"<reply>(.*?)(?:</reply>|$)", content, re.S)
                if m:
                    reply_text = m.group(1).strip()

                if not tool_calls:
                    break

                self.set_state("executing")
                frames = []
                for tc in tool_calls:
                    name = tc["function"]["name"]
                    try:
                        args = json.loads(tc["function"]["arguments"] or "{}")
                    except json.JSONDecodeError:
                        args = {}
                    label = f"{name}({json.dumps(args)[1:-1]})"
                    self.ui.send({"type": "tool", "text": label})
                    # first real desktop action => reveal the live Stream overlay
                    if name in ACTION_TOOLS:
                        self.last_action = label[:120]
                        self.start_stream()
                    result = self.run_tool(name, args)
                    frames += result.pop("_frames", [])
                    self.messages.append({"role": "tool", "tool_call_id": tc["id"],
                                          "content": json.dumps(result)})
                if frames:
                    parts = [{"type": "text",
                              "text": f"[{len(frames)} screen frame(s), in capture order]"}]
                    parts += [{"type": "image_url", "image_url": {"url": f}} for f in frames]
                    self.messages.append({"role": "user", "content": parts})
                self.set_state("thinking")

            if not reply_text:
                # model never used the tag protocol; fall back to full content
                last = self.messages[-1]
                if last["role"] == "assistant" and last.get("content"):
                    reply_text = re.sub(r"<[^>]+>", "", last["content"]).strip()
                    self.ui.send({"type": "reply", "text": reply_text})

            if reply_text:
                self.speak(reply_text)
            self.set_state("idle")
        except InterruptedError:
            self.ui.send({"type": "cot", "text": "\n[cancelled]"})
            self.set_state("idle")
        except Exception as e:
            self.error(f"{type(e).__name__}: {e}")
        finally:
            self.stop_stream()
            self.turn_lock.release()

    # ── input events ──────────────────────────────────────────────────
    def on_toggle(self):
        if self.state == "idle":
            self.ui.send({"type": "show"})
            self.start_recording()
        elif self.state == "listening":
            self.set_state("thinking")
            wav = self.stop_recording()
            if wav and self.wav_is_silent(wav):
                self.ui.send({"type": "cot",
                              "text": f"[mic captured silence — check input '{self.mic_target or 'default'}']"})
                self.set_state("idle")
                return
            text = self.transcribe(wav) if wav else None
            if not text:
                self.ui.send({"type": "cot", "text": "[heard nothing]"})
                self.set_state("idle")
                return
            # "activate social mode" → drop into the hands-free chat loop
            if self.is_enter_conversation(text):
                self.ui.send({"type": "transcript", "text": text})
                threading.Thread(target=self.conversation_loop, daemon=True).start()
                return
            threading.Thread(target=self.agent_turn, args=(text,), daemon=True).start()
        else:
            self.cancel_flag.set()

    def handle(self, msg):
        t = msg.get("type")
        # in social mode, F8 / cancel / hide all just leave the conversation
        if self.conv_active.is_set() and t in ("toggle", "cancel", "hide"):
            self.conv_exit.set()
            self.tts_stop.set()
            return
        if t == "toggle":
            self.on_toggle()
        elif t == "user_text" and msg.get("text", "").strip():
            if self.state == "listening":
                self.stop_recording()
            if self.state in ("idle", "listening"):
                self.ui.send({"type": "show"})
                threading.Thread(target=self.agent_turn,
                                 args=(msg["text"].strip(),), daemon=True).start()
        elif t == "cancel":
            if self.state == "listening":
                self.stop_recording()
                self.set_state("idle")
            else:
                self.cancel_flag.set()
        elif t == "hide":
            if self.state == "listening":
                self.stop_recording()
            self.cancel_flag.set()
            self.set_state("idle")
            self.ui.send({"type": "hide"})
        elif t == "list_mics":
            self.send_sources()
        elif t == "set_mic":
            name = msg.get("name", "").strip()
            if name:
                self.save_mic(name)
                for s in self.list_sources():
                    if s["name"] == name:
                        self.mic_target = s["id"]
                        break
                self.ui.send({"type": "mic", "device": name})
            self.send_sources()

    # ── socket server ─────────────────────────────────────────────────
    def client_loop(self, conn):
        self.ui.add(conn)
        try:
            conn.sendall((json.dumps({"type": "status", "value": self.state}) + "\n").encode())
        except OSError:
            return  # probe clients (the F8 script) disconnect immediately
        f = conn.makefile("r")
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                self.handle(json.loads(line))
            except Exception as e:
                log("bad client msg", line[:200], e)

    def heartbeat(self):
        # quickshell's Socket.connected is a desired-state flag, so the UI
        # detects a dead link by these pings going quiet
        while True:
            self.ui.send({"type": "ping"})
            time.sleep(3)

    def serve(self):
        try:
            os.unlink(SOCK_PATH)
        except FileNotFoundError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(SOCK_PATH)
        os.chmod(SOCK_PATH, 0o666)
        srv.listen(8)
        log("SIVA daemon listening on", SOCK_PATH)
        threading.Thread(target=self.heartbeat, daemon=True).start()
        # Warm the memory backend in the background so the embedding model is
        # loaded by the time the user speaks (cold start is several seconds).
        if self.memory.available:
            threading.Thread(target=self.memory.start, daemon=True).start()
        while True:
            conn, _ = srv.accept()
            threading.Thread(target=self.client_loop, args=(conn,), daemon=True).start()


if __name__ == "__main__":
    # Singleton guard: if another instance already holds the lock, exit
    # quietly. Prevents the toggle-script respawn path from stacking
    # daemons that steal each other's socket via unlink+rebind.
    import fcntl
    _singleton_lock = open("/tmp/siva-daemon.lock", "w")
    try:
        fcntl.flock(_singleton_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise SystemExit(0)
    Siva().serve()
