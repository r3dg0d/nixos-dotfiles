#!/usr/bin/env bash
# SIVA Voicefetch F7 toggle: open/close the voice-model downloader overlay.
# Starts the daemon on demand.

SOCK=/tmp/siva-voicefetch.sock

if ! socat -u OPEN:/dev/null UNIX-CONNECT:"$SOCK" 2>/dev/null; then
    setsid -f "$HOME/.local/bin/siva-voicefetch-daemon" >/dev/null 2>&1
    for _ in $(seq 1 50); do
        [[ -S "$SOCK" ]] && break
        sleep 0.1
    done
fi

echo '{"type":"toggle"}' | socat -t 1 - UNIX-CONNECT:"$SOCK"
